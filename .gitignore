__pycache__/
*.py[cod]
.ipynb_checkpoints/
analysis/notebook_with_output.ipynb
analysis/investigations/*_with_output.ipynb
.pytest_cache/
.test_tmp/*
!.test_tmp/.gitkeep
pytest-tmp/
probe700/
*.egg-info/
.venv/
.env

# Data: page caches and SQLite exports are large AND genuinely regenerable.
# The two derived tables below are neither -- they are the output of multi-day
# crawls whose own inputs are ignored here, so ignoring them too would leave the
# published boards versioned and the evidence behind them on one disk.
data/raw/
data/model_tuning/
data/external/fightmatrix/profiles/

# The page store (pages.sqlite, 320 MB) stays local. What staging reads from it
# is versioned beside it: every profile's birth date, and which career pages
# reached the corpus. Without them a new machine stages fewer birth dates.
data/external/sherdog/*
!data/external/sherdog/crossorg_bouts.parquet
!data/external/sherdog/profile_birth_dates.csv
!data/external/sherdog/career_pages_incorporated.json
!data/external/sherdog/ATTRIBUTION.txt
!data/external/sherdog/LICENSE.txt

# Snapshots are versioned whole: the fit's inputs, the fitted ratings and the
# boards. Ignoring them left the published boards rebuildable on one machine
# only (tests/test_release_committed.py). These three are local research runs
# that no published figure reads.
data/snapshots/2026-05-13/
data/snapshots/2026-06-23/
data/snapshots/2026-08-13-fightmatrix-public/
data/ufc_rank_engine.sqlite
data/ufc_rank_engine_fightmatrix_public.sqlite
data/ufc_rank_engine_fightmatrix_depth_one.sqlite

# Archived generated binaries/caches remain local and recoverable, not versioned.
_archive/**/generated-data/

# Half-built artifacts. Builders assemble beside the target and promote by
# atomic replace; only an interrupted run can leave one behind. The glob is
# open-ended because SQLite writes its rollback journal beside the file.
*.building*

# Accidental pip install artifacts (e.g. pip install pkg ==version)
=*
node_modules/
